---
import CardArt from "./CardArt.astro";

const cards = [
  ["Leader", "EB05-010", "Nico Robin"],
  ["4× OP09-106", "OP09-106", "Nico Olvia"],
  ["4× OP13-113", "OP13-113", "Lilith"],
  ["4× EB05-050", "EB05-050", "Atlas"],
  ["3× EB05-057", "EB05-057", "Nojiko"],
  ["4× OP17-109", "OP17-109", "Charlotte Pudding"],
  ["4× EB05-052", "EB05-052", "Gloriosa"],
  ["4× EB05-055", "EB05-055", "Nami"],
  ["4× OP17-114", "OP17-114", "Sweet 3 Generals"],
  ["3× OP17-112", "OP17-112", "Charlotte Linlin"],
  ["4× EB04-018", "EB04-018", "Megalo"],
  ["2× OP13-031", "OP13-031", "Trafalgar Law"],
  ["4× EB05-016", "EB05-016", "Nico Robin"],
  ["3× OP17-022", "OP17-022", "Shanks"],
  ["1× OP06-115", "OP06-115", "You're the One Who Should Disappear"],
  ["2× OP14-118", "OP14-118", "You'll Frighten Me…♡"],
];
const deck = [
  "1xEB05-010", "4xOP09-106", "4xOP13-113", "4xEB05-050",
  "3xEB05-057", "4xOP17-109", "4xEB05-052", "4xEB05-055",
  "4xOP17-114", "3xOP17-112", "4xEB04-018", "2xOP13-031",
  "4xEB05-016", "3xOP17-022", "1xOP06-115", "2xOP14-118",
];
---

<details class="deck-details">
  <summary>Open the 50-card list and copy it for testing</summary>
  <div class="deck-inside">
    <div class="deck-tools">
      <button class="button" type="button" id="copy">Copy OPTCGsim list</button>
      <a class="button alt" href="https://oplaytcg.com/deck-builder?d=2kFAoeIICWIKCHDLhpw34cwAw5gBI1YBoPsccA4dkBEFqNvHCjlgo" target="_blank" rel="noopener">Open deck builder ↗</a>
      <span class="deck-count">Leader 1 · Main deck 50</span>
      <span id="copied" class="fine" aria-live="polite"></span>
    </div>
    <pre class="deck" id="deck">{deck.join("\n")}</pre>
    <ul class="card-names" aria-label="Deck card names">
      {cards.map(([count, id, name]) => <li><CardArt name={name} id={id} size="list" /><span><b>{count}</b> {id} · {name}</span></li>)}
    </ul>
  </div>
</details>
